@page
@model Practica1.Pages.IndexModel
@{
    ViewData["Title"] = "Tareas Asignadas";
}

<div style="display:flex; justify-content:space-between; width:100%; align-items:center; margin-bottom: 15px; margin-top: 20px;">
    <h2 class="titulo-tareas">Tareas Asignadas</h2>
    <a href="/TareaCrear" class="btn-agregar-tarea">Crear Tarea</a>
</div>

<div class="fila-entre" style="margin-top:20px;">
    <form method="get" style="margin-bottom:15px; display: flex; align-items: center; flex-wrap: wrap;">
        <div style="margin-right: 20px; margin-bottom: 10px;">
            <label style="font-weight: 500; margin-right: 5px;">Filtrar por estado:</label>
            <select name="filtro" onchange="this.form.submit()" style="padding:5px; border-radius:4px; border:1px solid #ccc;">
                @if (Model.FiltroActual == "Todos")
                {
                    <option value="Todos" selected="selected">Todos</option>
                }
                else
                {
                    <option value="Todos">Todos</option>
                }

                @if (Model.FiltroActual == "Pendiente")
                {
                    <option value="Pendiente" selected="selected">Pendiente</option>
                }
                else
                {
                    <option value="Pendiente">Pendiente</option>
                }

                @if (Model.FiltroActual == "Encurso")
                {
                    <option value="Encurso" selected="selected">En curso</option>
                }
                else
                {
                    <option value="Encurso">En curso</option>
                }
            </select>
        </div>

        <div>
            <label>
                Mostrar:
                <select name="tamanio" onchange="this.form.submit()" style="margin:0 5px; padding:5px; border-radius:4px; border:1px solid #ccc;">
                    @if (Model.TamanoPagina == 5)
                    {
                        <option value="5" selected="selected">5</option>
                    }
                    else
                    {
                        <option value="5">5</option>
                    }

                    @if (Model.TamanoPagina == 10)
                    {
                        <option value="10" selected="selected">10</option>
                    }
                    else
                    {
                        <option value="10">10</option>
                    }

                    @if (Model.TamanoPagina == 15)
                    {
                        <option value="15" selected="selected">15</option>
                    }
                    else
                    {
                        <option value="15">15</option>
                    }

                    @if (Model.TamanoPagina == 25)
                    {
                        <option value="25" selected="selected">25</option>
                    }
                    else
                    {
                        <option value="25">25</option>
                    }
                </select>
                tareas por pagina
            </label>
        </div>
    </form>
</div>

<div style="color:#444; margin-bottom:15px;">
    Mostrando @(Model.TotalTareas == 0 ? 0 : ((Model.PaginaActual - 1) * Model.TamanoPagina) + 1)
    -
    @(Math.Min(Model.PaginaActual * Model.TamanoPagina, Model.TotalTareas))
    de @Model.TotalTareas tareas
    @if (Model.FiltroActual == "Pendiente")
    {
        <span style="font-weight: bold;"> (Pendientes)</span>
    }
    else if (Model.FiltroActual == "En curso")
    {
        <span style="font-weight: bold;"> (En curso)</span>
    }
</div>

<div class="tabla-responsive">
    <table class="tabla-tareas">
        <thead>
            <tr>
                <th>Nombre Tarea</th>
                <th>Fecha Vencimiento</th>
                <th>Estado Tarea</th>
                <th>Acciones</th>
            </tr>
        </thead>
        <tbody>
            @if (Model.Tareas.Count == 0)
            {
                <tr>
                    <td colspan="4">No hay tareas para mostrar</td>
                </tr>
            }
            else
            {
                @foreach (var tarea in Model.Tareas)
                {
                    <tr>
                        <td>@tarea.nombreTarea</td>
                        <td>@tarea.fechaVencimiento</td>
                        <td>
                            @if (tarea.estado == "Pendiente")
                            {
                                <span style="background-color: #d39cbc; color: #212529; padding: 3px 8px; border-radius: 4px; font-size: 0.85em;">
                                    @tarea.estado
                                </span>
                            }
                            else if (tarea.estado == "En curso")
                            {
                                <span style="background-color: #a15da2; color: white; padding: 3px 8px; border-radius: 4px; font-size: 0.85em;">
                                    @tarea.estado
                                </span>
                            }
                            else
                            {
                                <span style="background-color: #7a2c8c; color: white; padding: 3px 8px; border-radius: 4px; font-size: 0.85em;">
                                    @tarea.estado
                                </span>
                            }
                        </td>
                        <td>
                            <a href="#" class="btn-editar">Editar</a>
                            <a href="#" class="btn-eliminar">Eliminar</a>
                        </td>
                    </tr>
                }
            }
        </tbody>
    </table>
</div>

<div style="text-align: center; margin-top: 20px;">
    <ul style="display: flex; list-style-type: none; padding: 0; justify-content: center;">
        @for (int i = 1; i <= Model.TotalPaginas; i++)
        {
            <li style="margin: 0 5px;">
                <a href="?pagina=@i&tamanio=@Model.TamanoPagina&filtro=@Model.FiltroActual"
                   style="padding: 8px 12px; text-decoration: none; border-radius: 4px;
                    @(i == Model.PaginaActual ?
                        "background-color: #3163c9; color: white;" :
                        "background-color: #eaf1fb; color: #333;")">
                    @i
                </a>
            </li>
        }
    </ul>
</div>